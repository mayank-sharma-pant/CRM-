# ──────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to .env and fill in real values. NEVER commit .env
# ──────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# Database (PostgreSQL on Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — your frontend domain(s), comma separated, NO trailing slash
CORS_ORIGINS=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TLS=true

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# AI (Gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_ACTIONS_PER_REQUEST=5
