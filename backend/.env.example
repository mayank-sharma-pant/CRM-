# ──────────────────────────────────────────────────────────────────
# Environment template — copy to .env and fill in real values. NEVER commit .env
#
# PRODUCTION CORS: define CORS_ORIGINS and FRONTEND_URL exactly ONCE each.
# If you paste two FRONTEND_URL= lines, some loaders keep the first (localhost) and
# you get browser CORS errors on https://your-real-domain.
# On Railway/Render/Fly: set these in the dashboard — a local .env is not used there.
# ──────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# Uvicorn/Starlette: hosts trusted for X-Forwarded-* (behind nginx, Caddy, Railway, etc.)
# Include your public API hostname(s). Keep 127.0.0.1 if the proxy connects locally.
TRUSTED_HOSTS=127.0.0.1,localhost,your-frontend-domain.com

# Database (PostgreSQL on Neon, Supabase, etc.)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — live site(s) only in production (NOT http://localhost:3000 unless you only test locally)
# Example: CORS_ORIGINS=https://crm.example.com,https://www.crm.example.com
CORS_ORIGINS=https://your-frontend-domain.com
# Used in email links etc.; must match the origin users open in the browser
FRONTEND_URL=https://your-frontend-domain.com

# Public origin of THIS backend. Used for OAuth redirect URIs, provider webhooks,
# and the email open-pixel / click-redirect URLs (7.1). It must be reachable from a
# recipient's mail client: while it is empty or a loopback host, email tracking is
# skipped and outbound links are sent unwrapped.
PUBLIC_API_URL=https://your-backend-domain.com

# Auth cookie settings
# If frontend and backend are on different sites, use:
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TLS=true

# Logging level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Optional: explicit secure cookies (defaults: Secure=true when ENVIRONMENT=production)
# AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true

OPENAI_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.3-codex
AI_RATE_LIMIT_PER_MINUTE=20
AI_MAX_ACTIONS_PER_REQUEST=5

# Team chat — off by default. Enabling without a valid key returns 503 on chat routes only.
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back the key up off-server: losing it makes every stored message unreadable.
# Rotation: put the new key first, keep old keys after it (comma-separated).
CHAT_ENABLED=false
CHAT_ENCRYPTION_KEY=
# Exact browser origins allowed to open wss://<api>/api/chat/ws (defaults to CORS_ORIGINS)
CHAT_WS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# The URL browsers connect to (served directly by this backend, not via Vercel). Empty ⇒ polling only.
CHAT_WS_PUBLIC_URL=wss://your-backend-domain.com/api/chat/ws
# Required in production for live updates (WS tickets, cross-worker events). Bind Redis to 127.0.0.1.
REDIS_URL=redis://127.0.0.1:6379/0
CHAT_SEND_LIMIT_PER_10S=20
