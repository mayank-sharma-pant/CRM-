# BACKEND_URL is server-only: Vercel rewrites /api/* → this URL (see next.config.mjs).
# Leave NEXT_PUBLIC_API_URL empty so the browser only hits /api on this site (no CORS).

NEXT_PUBLIC_API_URL=
BACKEND_URL=https://api.perioxia.com

# Local dev (PowerShell): $env:BACKEND_URL="http://127.0.0.1:8000"; npm run dev

# Vercel: set BACKEND_URL in Production env. Remove or leave empty NEXT_PUBLIC_API_URL.
