# Single env file (replaces .env, .env.local, .env.production).
# NEXT_PUBLIC_* is exposed to the browser; BACKEND_URL is server-side (rewrites / API routes).
#
# Production — must be https, no trailing slash, no /api suffix on BACKEND_URL.
NEXT_PUBLIC_API_URL=https://crm.perioxia.com
BACKEND_URL=https://api.perioxia.com
#
# Local dev (uncomment or set in shell before npm run dev):
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#   BACKEND_URL=http://127.0.0.1:8000
# PowerShell example:
#   $env:BACKEND_URL="http://127.0.0.1:8000"; npm run dev
#
# Vercel: add NEXT_PUBLIC_API_URL and BACKEND_URL under Project → Settings → Environment Variables (Production).
