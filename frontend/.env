# Single env file for this app (production-oriented).
# 1) Replace BACKEND_URL with your real AWS API base URL (ask AWS console / deploy output).
#    Must be https, no trailing slash, no /api on the end — e.g. https://abc123.execute-api.region.amazonaws.com
# 2) On Vercel: add the same two variables in Project → Settings → Environment Variables (Production).

NEXT_PUBLIC_API_URL=https://crm.perioxia.com
BACKEND_URL=https://REPLACE_WITH_YOUR_AWS_API_BASE_URL

# Optional — local dev against FastAPI on your PC (PowerShell):
#   $env:BACKEND_URL="http://127.0.0.1:8000"; npm run dev
